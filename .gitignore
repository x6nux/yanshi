*.appstate.json
config.local.yaml
*.local.yaml
.env
*.env
/secrets/
/secrets.enc

# --- 日志 ---
*.log
/logs/

# --- Web 前端 ---
node_modules/
web/dist/
web/node_modules/

# --- IDE / 编辑器 ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- 操作系统 ---
.DS_Store
Thumbs.db
desktop.ini
# Local reference checkouts and generated analysis material.
reference/

# local dev worktrees (subagent-driven execution)
.worktrees/
.claude/worktrees/

# runtime scratch dir (spillover temp files, etc.)
.yanshi/

# --- 覆盖率/分析产物（勿入库）---
cov2.html
pkglist.tmp
_analyze_cov.go

# Python cache (H2 SDK examples)
__pycache__/
*.pyc

# Dev analysis scratch (depsanalyze/codelines byproducts)
_covstats.py
_tmp_analyze_cov.py
deps_raw.txt
*.tmp

# Benchmark output written by scripts/bench.sh (old.txt/new.txt baselines).
.bench-results/
