{
  "name": "yanshi-vscode",
  "displayName": "Yanshi Agent",
  "description": "Run Yanshi turns from VS Code with streamed output and diffs",
  "version": "0.1.0",
  "publisher": "x6nux",
  "license": "MIT",
  "engines": { "vscode": "^1.92.0" },
  "categories": ["Other", "Programming Languages"],
  "activationEvents": [
    "onCommand:yanshi.run",
    "onCommand:yanshi.cancel",
    "onCommand:yanshi.showDiff"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build:sdk": "npm --prefix ../../sdk/ts run build",
    "compile": "npm run build:sdk && tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run compile && vitest run",
    "package": "npm run test && npx vsce package --no-dependencies"
  },
  "dependencies": {
    "@x6nux/yanshi-sdk": "file:../../sdk/ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.92.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "contributes": {
    "commands": [
      { "command": "yanshi.run", "title": "Yanshi: Run Turn" },
      { "command": "yanshi.cancel", "title": "Yanshi: Cancel Turn" },
      { "command": "yanshi.showDiff", "title": "Yanshi: Show Last Diff" }
    ],
    "configuration": {
      "title": "Yanshi",
      "properties": {
        "yanshi.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "V14 Agent API origin (D1's flat routes are served under /api/v1)."
        },
        "yanshi.streamTransport": {
          "type": "string",
          "enum": ["sse", "ws"],
          "default": "sse",
          "description": "D1 only serves SSE today; WS is forward-looking."
        },
        "yanshi.maxOpenFiles": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 16,
          "description": "Maximum number of open workspace files attached as IDE context per turn."
        },
        "yanshi.maxContextBytes": {
          "type": "number",
          "default": 32768,
          "minimum": 1024,
          "maximum": 262144,
          "description": "Shared UTF-8 byte budget across selection + open files context."
        }
      }
    }
  }
}
