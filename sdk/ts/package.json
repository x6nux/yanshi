{
  "name": "@x6nux/yanshi-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Yanshi Agent API v1",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist", "schema", "../schema"],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": { "node": ">=20" },
  "scripts": {
    "generate": "echo \"types are generated by D1 cmd/api-schema into ../v1.ts; nothing to regenerate\" && exit 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "pack:check": "npm run test && npm pack --dry-run",
    "prepublishOnly": "npm run pack:check"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
